@startuml C2_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "User (Dmitry)")

System_Boundary(app, "Prepare Me") {

    Container(cli,           "CLI",                   "Java / Picocli",  "Entry point. Parses draft-plan and create-agenda sub-commands with --date flag.")
    Container(usecases,      "Use Cases",             "Java",            "CreateMeetingCards (draft-plan) and PrepareMeetingNotes (create-agenda). Business rules: event filtering, 1-1 detection, name extraction, card grouping.")
    Container(calAdapter,    "Calendar Adapter",      "Java",            "Implements CalendarPort. Fetches and filters calendar events via Google Calendar API.")
    Container(plannerAdapter, "Planner Adapter",       "Java",            "Implements MeetingBoardPort. Creates cards in 'Meetings' list; reads ordered card list with topics. Handles Trello OAuth 1.0a PIN flow internally (first run only); persists token to ~/.prepare-me/tokens/trello.json.")
    Container(notesAdapter,  "Notes Storage Adapter", "Java",            "Implements MeetingNotesPort. Searches for note documents by name; appends dated Heading 1 + topics.")
    Container(googleAuth,    "Google Auth Provider",  "Java",            "Shared OAuth 2.0 token lifecycle (Calendar + Drive). Persists tokens to ~/.prepare-me/tokens/google.json.")
    Container(manualResolver,"Manual Doc Name Resolver", "Java / stdin-stdout + YAML", "Implements ManualLinkResolverPort. Checks ~/.prepare-me/doc-mappings.yaml first; if no entry found, prompts user to type the document name and persists the mapping for future runs.")
    Container(composition,   "AppComposition",        "Java",            "Manual DI root — wires auth providers → adapters → use cases → CLI commands.")
}

System_Ext(gcal,     "Google Calendar API v3")
System_Ext(trelloApi,"Trello REST API")
System_Ext(driveApi, "Google Drive API v3")
System_Ext(docsApi,  "Google Docs API v1")
System_Ext(gauth,    "Google OAuth 2.0")
System_Ext(tauth,    "Trello OAuth 1.0a")

Rel(user,          cli,           "draft-plan / create-agenda --date YYYY-MM-DD", "Terminal")
Rel(cli,           usecases,      "execute(date)")
Rel(usecases,       calAdapter,     "getMeetings(date)")
Rel(usecases,       plannerAdapter, "createCard() / getMeetingsWithTopics()")
Rel(usecases,       notesAdapter,    "findDoc(name, type) / appendAgenda(docId, date, topics)")
Rel(usecases,       manualResolver,  "resolveDocName(meetingTitle)")
Rel(calAdapter,     googleAuth,      "getAccessToken()")
Rel(notesAdapter,   googleAuth,      "getAccessToken()")
Rel(calAdapter,     gcal,           "GET /calendars/primary/events",               "HTTPS")
Rel(plannerAdapter, trelloApi,      "POST /cards  GET /lists/{id}/cards",          "HTTPS")
Rel(notesAdapter,   driveApi,       "GET /files?q=name contains ...",              "HTTPS")
Rel(notesAdapter,   docsApi,        "GET + POST /documents/{id}/batchUpdate",      "HTTPS")
Rel(googleAuth,    gauth,         "Authorization Code flow + refresh")
Rel(plannerAdapter, tauth,        "OAuth 1.0a PIN flow (first run only)", "HTTPS")
Rel(composition,   cli,           "wires")

@enduml
